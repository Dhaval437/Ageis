# Normalise to LF in the repo, matching .editorconfig.
* text=auto eol=lf

# Windows-native tooling that wants CRLF on disk.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.pfx  binary

